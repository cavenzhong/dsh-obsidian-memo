{
  "name": "dsh-obsidian-memo",
  "version": "0.16.6",
  "type": "module",
  "description": "dsh-obsidian-memo：DeepSeek Harness 的 Obsidian 便签插件。把 Obsidian 进行时文件夹变成淡色便签墙，支持快速新建、多图与 WebP 压缩、阅读/编辑、AI 评论、归档、开档与在 Obsidian 打开。",
  "main": "lib/index.js",
  "icon": "icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "scripts",
    "locale",
    "docs",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "build:check": "node scripts/build-client.mjs --check",
    "dev": "node scripts/build-client.mjs --watch",
    "test": "pnpm build:check && node --test",
    "prepack": "npm run build",
    "bench": "node --expose-gc scripts/benchmark.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "cordis",
    "obsidian",
    "markdown",
    "notes",
    "sticky-notes",
    "productivity"
  ],
  "author": "cavenzhong",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cavenzhong/dsh-obsidian-memo.git"
  },
  "homepage": "https://github.com/cavenzhong/dsh-obsidian-memo#readme",
  "bugs": {
    "url": "https://github.com/cavenzhong/dsh-obsidian-memo/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "esbuild": "0.25.12"
  }
}
